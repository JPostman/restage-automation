{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ReSTage: Debug All Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ReSTage: Build",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "RESTAGE_ACTION_DELAY_MS": "0",
        "RESTAGE_INSPECT_ON_FAILURE": "0",
        "RESTAGE_CONTINUE_ON_FAILURE": "1"
      },
      "autoAttachChildProcesses": true,
      "runtimeArgs": [
        "--enable-source-maps"
      ],
      "args": [
        "test",
        "--config=dist/src/suites/suites.js"
      ]
    },
    {
      "name": "ReSTage: Debug Test Class",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ReSTage: Build",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "RESTAGE_ACTION_DELAY_MS": "500",
        "RESTAGE_TEST_TARGET": "${input:restageTestTarget}",
        "RESTAGE_INSPECT_ON_FAILURE": "1",
        "RESTAGE_INSPECT_ON_COMPLETE": "1",
        "RESTAGE_CONTINUE_ON_FAILURE": "0"
      },
      "autoAttachChildProcesses": true,
      "runtimeArgs": [
        "--enable-source-maps"
      ],
      "args": [
        "test",
        "--config=dist/src/suites/suites.js"
      ]
    }
  ],
  "inputs": [
    {
      "id": "restageTestTarget",
      "type": "pickString",
      "description": "Choose the Playwright test suite.",
      "options": [
        "suite1",
        "suite2",
        "suite3",
        "suite4"
      ],
      "default": "suite1"
    }
  ]
}
