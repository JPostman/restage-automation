{
  "name": "restage-automation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Playwright automation bootstrap for ReSTage Studio",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --enable-source-maps dist/src/main.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "inspect": "npm run build && node --enable-source-maps dist/src/inspect.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "debug": "npm run build && node --enable-source-maps --inspect-brk dist/src/main.js"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "playwright-core": "1.61.0",
    "prettier": "^3.9.6",
    "typescript": "5.8.3"
  }
}
